{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "seed": {
      "cache": false
    },
    "seed:permissions": {
      "cache": false
    },
    "seed:admin": {
      "cache": false
    },
    "seed:demo": {
      "cache": false
    }
  }
}
